# Copy to .env for API/worker. Demo is intentionally off by default.
APP_ENV=development
DEMO_MODE=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/regguard
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY for new projects.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=3000
AI_MONTHLY_BUDGET_USD=5
AI_INPUT_USD_PER_MILLION=0.40
AI_OUTPUT_USD_PER_MILLION=1.60
EVM_RPC_URL=
EVM_CHAIN_ID=11155111
AUDIT_REGISTRY_ADDRESS=
ANCHOR_SIGNER_PRIVATE_KEY=
CRE_MODE=unavailable
# Browser-safe values only. Copy these into apps/web/.env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
